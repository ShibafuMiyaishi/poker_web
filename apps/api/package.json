{
  "name": "@pokergo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply pokergo --local",
    "db:migrate:remote": "wrangler d1 migrations apply pokergo --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@pokergo/engine": "workspace:*",
    "@pokergo/gto-charts": "workspace:*",
    "@pokergo/shared": "workspace:*",
    "hono": "^4.6.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.27",
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.86.0"
  }
}
